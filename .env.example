# Render: configure these variables in the service dashboard
NODE_ENV=production
PORT=10000
CLIENT_ORIGIN=https://dunu.example.com
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/dunu?retryWrites=true&w=majority
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d
ADMIN_NAME=Administrateur DUNU
ADMIN_EMAIL=admin@dunu.bj
ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FEEXPAY_API_KEY=
FEEXPAY_SHOP_ID=
FEEXPAY_WEBHOOK_SECRET=
FEEXPAY_ENV=production
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional map key; do not expose server secrets in VITE_ variables
MAPTILER_API_KEY=

# Coordonnées publiques DUNU BENIN
PUBLIC_CONTACT_EMAIL=contact@dunubenin.com
PUBLIC_COMPLAINT_EMAIL=reclamation@dunubenin.com
PUBLIC_PHONE=+2290142222197
DEFAULT_COMMISSION_RATE=10
DEFAULT_DELIVERY_FEE=700
COD_MINIMUM_BALANCE=1000

# Abonnements restaurants (FCFA pour 30 jours)
SUBSCRIPTION_STARTER_XOF=5000
SUBSCRIPTION_BUSINESS_XOF=10000
SUBSCRIPTION_PREMIUM_XOF=20000

# WebRTC: serveur TURN conseillé pour les réseaux mobiles / NAT restrictifs.
# Utiliser coturn avec l'authentification TURN REST (secret partagé).
# Les identifiants temporaires sont générés côté serveur pour chaque utilisateur.
TURN_URLS=turn:turn.votre-domaine.com:3478,turns:turn.votre-domaine.com:5349
TURN_SHARED_SECRET=REMPLACER_PAR_UN_SECRET_LONG_ALEATOIRE

# Réinitialisation sécurisée du mot de passe par e-mail (Resend)
RESEND_API_KEY=
MAIL_FROM=DUNU BENIN <no-reply@dunubenin.com>
APP_URL=https://dunubenin.com
